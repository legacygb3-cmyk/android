package com.example.fragmentlifecycle;

import androidx.appcompat.app.AppCompatActivity;
import android.os.Bundle;
import android.widget.Button;

public class MainActivity extends AppCompatActivity {

  private boolean isFragmentOneLoaded = true;
  private final androidx.fragment.app.FragmentManager fragmentManager =
          getSupportFragmentManager();

  @Override
  protected void onCreate(Bundle savedInstanceState) {
      super.onCreate(savedInstanceState);
      setContentView(R.layout.activity_main);

      Button btnChange = findViewById(R.id.btn_change); // Ensure ID matches activity_main.xml
      loadFragmentOne();

      btnChange.setOnClickListener(v -> {
          if (isFragmentOneLoaded) {
              loadFragmentTwo();
          } else {
              loadFragmentOne();
          }
      });
  }

  private void loadFragmentOne() {
      androidx.fragment.app.FragmentTransaction transaction =
              fragmentManager.beginTransaction();
      FragmentOne fragment = new FragmentOne();
      transaction.replace(R.id.fragment_holder, fragment); // Ensure ID matches activity_main.xml
      transaction.addToBackStack(null);
      transaction.commit();
      isFragmentOneLoaded = true;
  }

  private void loadFragmentTwo() {
      androidx.fragment.app.FragmentTransaction transaction =
              fragmentManager.beginTransaction();
      FragmentTwo fragment = new FragmentTwo();
      transaction.replace(R.id.fragment_holder, fragment); // Ensure ID matches activity_main.xml
      transaction.addToBackStack(null);
      transaction.commit();
      isFragmentOneLoaded = false;
  }
}

